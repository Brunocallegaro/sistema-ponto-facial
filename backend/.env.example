# Copie este arquivo para ".env" e ajuste os valores.
# --- Segurança (TROQUE antes de usar com dados reais) ---
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TOKEN_EXPIRA_MINUTOS=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reconhecimento facial ---
MODEL_NAME=Facenet512
DETECTOR_BACKEND=opencv
DISTANCE_METRIC=cosine
# Vazio = limite oficial do DeepFace (Facenet512 + cosine = 0.30). Menor = mais rigoroso.
DISTANCE_THRESHOLD=
MARGEM_AMBIGUIDADE=0.05

# --- Qualidade da imagem ---
BRILHO_MINIMO=60
NITIDEZ_MINIMA=25
CONFIANCA_DETECCAO_MINIMA=0.80
ROSTO_MIN_LADO=80

# --- Origem da imagem ---
# true = permite reconhecer por foto enviada (galeria/arquivo). Menos seguro: use false em produção.
PERMITIR_FOTO_ARQUIVO=true

# --- Regras do ponto ---
INTERVALO_MINIMO_SEGUNDOS=60
